{
  "name": "webmcp-vue",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Vue composables for exposing typed tools through document.modelContext.",
  "author": "HaNdTriX <handtrix@example.com>",
  "license": "MIT",
  "homepage": "https://github.com/HaNdTriX/webmcp-vue#readme",
  "repository": {
