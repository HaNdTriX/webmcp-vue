    "@vue/eslint-config-typescript": "^14.9.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "playwright": "^1.61.1",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
